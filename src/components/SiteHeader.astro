---
import { AFFILIATE_URL } from "@/lib/constants";
import { LOCALES, type Locale } from "@/lib/constants";
import { hrefLocale } from "@/lib/links";

interface Props {
  locale: Locale;
  slugPath: string;
}
const { locale, slugPath } = Astro.props;
const cta = locale === "ru" ? "Играть" : locale === "kz" ? "Ойнау" : "Play";
---

<header
  class="sticky top-0 z-40 border-b border-jet-border/80 bg-jet-bg/85 backdrop-blur-md"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3">
    <a href={hrefLocale(locale, "")} class="flex items-center gap-2 text-white hover:text-jet-cyan">
      <span
        class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-gradient-to-br from-violet-600 to-cyan-500 font-display font-bold text-sm shadow-neon"
        >XJ</span
      >
      <span class="font-display font-semibold tracking-tight hidden sm:inline">X Jet</span>
    </a>
    <nav class="hidden md:flex items-center gap-5 text-sm text-slate-400">
      <a href={hrefLocale(locale, "demo")} class="hover:text-white">Demo</a>
      <a href={hrefLocale(locale, "play")} class="hover:text-white">Play</a>
      <a href={hrefLocale(locale, "strategy")} class="hover:text-white">Strategy</a>
      <a href={hrefLocale(locale, "blog/x-jet-demo")} class="hover:text-white">Blog</a>
    </nav>
    <div class="flex items-center gap-2 sm:gap-3">
      <div class="flex rounded-lg border border-jet-border bg-jet-surface/80 p-0.5 text-xs">
        {
          LOCALES.map((loc) => (
            <a
              href={hrefLocale(loc, slugPath)}
              class:list={[
                "px-2 py-1 rounded-md transition-colors",
                loc === locale ? "bg-violet-600 text-white" : "text-slate-400 hover:text-white",
              ]}
              hreflang={loc === "kz" ? "kk" : loc}
            >
              {loc.toUpperCase()}
            </a>
          ))
        }
      </div>
      <a
        href={AFFILIATE_URL}
        target="_blank"
        rel="noopener noreferrer sponsored"
        class="hidden sm:inline-flex items-center rounded-lg bg-gradient-to-r from-violet-600 to-cyan-500 px-4 py-2 text-sm font-semibold text-white shadow-neon"
      >
        {cta}
      </a>
    </div>
  </div>
</header>
