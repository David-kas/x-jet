---
interface Props {
  title: string;
  subtitle: string;
}
const { title, subtitle } = Astro.props;
---

<section
  class="relative overflow-hidden rounded-2xl border border-jet-border bg-gradient-to-br from-jet-card via-jet-surface to-jet-bg p-6 sm:p-10 mb-10"
  aria-label="X Jet hero"
>
  <div
    class="pointer-events-none absolute inset-0 bg-[length:24px_24px] bg-grid-fade opacity-90"
    aria-hidden="true"
  >
  </div>
  <div class="relative z-10 flex flex-col lg:flex-row lg:items-center gap-8">
    <div class="flex-1 space-y-3">
      <p class="text-xs uppercase tracking-[0.25em] text-jet-cyan/90">X Jet · crash game</p>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-display font-semibold text-white leading-tight">
        {title}
      </h1>
      <p class="text-slate-400 max-w-2xl text-sm sm:text-base">{subtitle}</p>
    </div>
    <div class="flex-shrink-0 w-full max-w-md mx-auto lg:mx-0" aria-hidden="true">
      <svg viewBox="0 0 400 220" class="w-full h-auto drop-shadow-neon">
        <defs>
          <linearGradient id="g1" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#22d3ee"></stop>
            <stop offset="100%" stop-color="#a855f7"></stop>
          </linearGradient>
          <filter id="blur" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur stdDeviation="6" result="b"></feGaussianBlur>
          </filter>
        </defs>
        <path
          d="M20 180 Q 80 40 200 90 T 380 30"
          fill="none"
          stroke="url(#g1)"
          stroke-width="4"
          stroke-linecap="round"
          filter="url(#blur)"
          opacity="0.35"></path>
        <path
          d="M20 180 Q 80 40 200 90 T 380 30"
          fill="none"
          stroke="url(#g1)"
          stroke-width="3"
          stroke-linecap="round"></path>
        <g transform="translate(300, 48) rotate(-12)">
          <path
            d="M0 10 L40 0 L32 8 L52 12 L34 16 L28 28 Z"
            fill="#c4b5fd"
            stroke="#a855f7"
            stroke-width="1.5"></path>
          <circle cx="8" cy="12" r="3" fill="#22d3ee"></circle>
        </g>
        <text x="24" y="205" fill="#94a3b8" font-size="11" font-family="system-ui"
          >multiplier · coefficient · bet</text
        >
      </svg>
    </div>
  </div>
</section>
