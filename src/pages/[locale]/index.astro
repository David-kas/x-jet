---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeroJet from "@/components/HeroJet.astro";
import CtaInline from "@/components/CtaInline.astro";
import SimilarQueries from "@/components/SimilarQueries.astro";
import InternalLinks from "@/components/InternalLinks.astro";
import SeoFigure from "@/components/SeoFigure.astro";
import { LOCALES, type Locale } from "@/lib/constants";
import { generateArticle } from "@/lib/content-generator";
import { buildSeo } from "@/lib/seo";
import { pageH1, pageSubtitle } from "@/lib/h1";
import { buildInternalLinks } from "@/lib/links";
import { buildArticleJsonLd, buildFaqJsonLd, buildPageGraphJsonLd } from "@/lib/schema";
import { luckyJetRuArticle } from "@/data/luckyjet-ru";
import { luckyJetSeoImages } from "@/data/seo-images";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const slugPath = "";
const cluster = "home";
const seo = buildSeo(locale, cluster, slugPath);
const article = generateArticle(locale, cluster, slugPath);
const activeArticle = locale === "ru" ? luckyJetRuArticle : article;
const internal = buildInternalLinks(locale, slugPath);
const faqLd = buildFaqJsonLd(seo.canonical, activeArticle.faq);
const articleLd = buildArticleJsonLd({
  url: seo.canonical,
  headline: pageH1(locale, cluster, slugPath),
  description: seo.description,
  locale,
  dateModified: "2026-09-20",
  wordCount: activeArticle.wordCount,
  images: locale === "ru" ? luckyJetSeoImages.map((image) => image.src) : undefined,
});
const pageGraphLd = buildPageGraphJsonLd({
  url: seo.canonical,
  title: seo.title,
  description: seo.description,
  locale,
  slugPath,
  images: locale === "ru" ? luckyJetSeoImages : undefined,
});
const imageSlots: Record<number, number> = {
  1: 0,
  2: 1,
  3: 2,
  5: 3,
  7: 4,
  9: 5,
  12: 6,
  15: 7,
  17: 8,
  20: 9,
};
const seoImageForSection = (index: number) => {
  if (locale !== "ru") return undefined;
  const imageIndex = imageSlots[index];
  return imageIndex === undefined ? undefined : luckyJetSeoImages[imageIndex];
};
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  canonical={seo.canonical}
  locale={locale}
  slugPath={slugPath}
  faqLd={faqLd}
  articleLd={articleLd}
  pageGraphLd={pageGraphLd}
>
  <HeroJet title={pageH1(locale, cluster, slugPath)} subtitle={pageSubtitle(locale, slugPath)} />
  <CtaInline locale={locale} />
  <article class="prose-page max-w-none">
    {
      activeArticle.sections.map((sec, i) => (
        <>
          <section class="scroll-mt-28" id={sec.id}>
            <h2>{sec.title}</h2>
            <div set:html={sec.html} />
          </section>
          <SeoFigure image={seoImageForSection(i)} />
          {(i + 1) % 2 === 0 && <CtaInline locale={locale} />}
        </>
      ))
    }
    <section class="mt-16" aria-labelledby="faq-h">
      <h2 id="faq-h" class="text-2xl font-semibold text-white mb-6 font-display">FAQ</h2>
      <div class="space-y-4">
        {
          activeArticle.faq.map((item) => (
            <div class="rounded-xl border border-jet-border bg-jet-card/50 p-4">
              <h3 class="text-lg font-semibold text-violet-200 mb-2">{item.question}</h3>
              <p class="text-slate-300 leading-relaxed">{item.answer}</p>
            </div>
          ))
        }
      </div>
    </section>
  </article>
  <SimilarQueries locale={locale} items={activeArticle.similarQueries} />
  <InternalLinks locale={locale} links={internal} />
</BaseLayout>
